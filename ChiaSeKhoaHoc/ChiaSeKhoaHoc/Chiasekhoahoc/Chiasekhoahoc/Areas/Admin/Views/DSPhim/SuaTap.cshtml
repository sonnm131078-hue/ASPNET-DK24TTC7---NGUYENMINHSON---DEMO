@{
    ViewBag.Title = "Sửa bài học - Quản trị - Khóa Học";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
@model WebsiteMovie_DAN.Models.CTTapPhim
@using (Html.BeginForm())
{
    @Html.ValidationSummary(true)

    <fieldset>
        <legend></legend>

        <div class="editor-field">
            <table>
                <tr>
                    <td>
                        <b>Mã Khóa học   </b>
                    </td>
                    <td>
                        @Model.ID
                    </td>
                </tr>
                <tr>
                    <td style="width:125px"><b> bài học</b></td>

                    <td>
                        @Model.TapPhim
                </td>
            </tr>
            <tr>
                <td style="width:125px"><b> Link bài học</b></td>
                <td>
                    @Html.TextBoxFor(model => model.Link, new { @class = "form-control" })
            </td>
            <td style="color:red">
                @ViewData["Loi1"]
                @ViewData["Loi2"]
            </td>
        </tr>
    </table>
</div>
<p>
    <input type="submit" value="Lưu cập nhật" class="btn btn-success" />
</p>
</fieldset>
}
<div>
    <button type="button" class="btn btn-secondary">@Html.ActionLink("Trở lại", "QuocGia", "DanhMuc")</button>
</div>
